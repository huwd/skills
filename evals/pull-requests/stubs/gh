#!/usr/bin/env python3
"""Offline stand-in for the GitHub CLI in pull-request evals.

`gh pr create` records the pull request in .gh-state/pr.json at the
repository root and prints a URL, failing if the head branch has not been
pushed to origin. Read-only queries answer as for a repository with no
open pull requests. Anything else fails, so a run cannot merge, edit or
change settings.
"""

import json
from pathlib import Path
import subprocess
import sys

REPO = "example/ledger"


def fail(message, code=1):
    print(message, file=sys.stderr)
    raise SystemExit(code)


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True)


def root():
    result = git("rev-parse", "--show-toplevel")
    if result.returncode:
        fail("not a git repository")
    return Path(result.stdout.strip())


def option(args, *names):
    for index, arg in enumerate(args):
        for name in names:
            if arg == name and index + 1 < len(args):
                return args[index + 1]
            if name.startswith("--") and arg.startswith(name + "="):
                return arg.split("=", 1)[1]
    return None


def create(args):
    top = root()
    head = option(args, "--head", "-H") or git("rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    if git("ls-remote", "--exit-code", "origin", f"refs/heads/{head}").returncode:
        fail("aborted: you must first push the current branch to a remote, or use the --head flag")
    body_file = option(args, "--body-file", "-F")
    body = option(args, "--body", "-b")
    if body_file:
        body = sys.stdin.read() if body_file == "-" else Path(body_file).read_text()
    if body is None:
        fail("must provide `--title` and `--body` (or `--fill`) when not running interactively")
    record = {"title": option(args, "--title", "-t"), "body": body, "base": option(args, "--base", "-B") or "main",
              "head": head, "draft": "--draft" in args or "-d" in args,
              "body_source": "file" if body_file else "argument"}
    state = top / ".gh-state"
    state.mkdir(exist_ok=True)
    (state / "pr.json").write_text(json.dumps(record, indent=2) + "\n")
    print(f"https://github.com/{REPO}/pull/1")


def main(args):
    if args[:2] == ["auth", "status"]:
        print("github.com\n  ✓ Logged in to github.com account fixture (keyring)")
        return
    if args[:2] == ["repo", "view"]:
        print(json.dumps({"nameWithOwner": REPO, "defaultBranchRef": {"name": "main"}}))
        return
    if args[:2] == ["pr", "create"]:
        create(args[2:])
        return
    if args[:2] == ["pr", "list"]:
        print("[]" if "--json" in args else "no open pull requests in example/ledger")
        return
    if args[:2] in (["pr", "view"], ["pr", "status"]):
        fail("no pull requests found for branch")
    fail(f"gh stub: unsupported command: gh {' '.join(args)}")


if __name__ == "__main__":
    main(sys.argv[1:])
